NODE_ENV=development

# Connexion directe à PostgreSQL (pas de pooler à ce stade du bootstrap).
DATABASE_URL=postgresql://tripplanner:tripplanner@localhost:5432/tripplanner

# Base fantôme utilisée par `prisma migrate dev` pour calculer le diff.
# Doit exister au préalable avec les mêmes extensions/fonctions que la base
# principale (citext, pgcrypto, uuid_generate_v7()) — voir
# infra/docker/postgres/init-uuidv7.sql. Créer avec :
#   docker exec docker-postgres-1 psql -U tripplanner -d tripplanner -c "CREATE DATABASE tripplanner_shadow;"
#   docker exec -i docker-postgres-1 psql -U tripplanner -d tripplanner_shadow < infra/docker/postgres/init-uuidv7.sql
SHADOW_DATABASE_URL=postgresql://tripplanner:tripplanner@localhost:5432/tripplanner_shadow

# Provisionné pour un usage futur (cache/queue) — aucun code ne s'y connecte
# encore à cette étape du bootstrap.
REDIS_URL=redis://localhost:6379

JWT_ACCESS_SECRET=change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me
JWT_REFRESH_TTL=30d

PORT=3000
LOG_LEVEL=info
