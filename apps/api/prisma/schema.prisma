  @@map("vehicles")
}

enum DriverBackgroundCheckStatus {
  Pending @map("pending")
  Passed  @map("passed")
  Failed  @map("failed")
  Expired @map("expired")
}

/// Historique de vérification — jamais écrasé, chaque contrôle est une
/// nouvelle ligne (traçabilité légale de conformité).
model DriverBackgroundCheck {
  id              String                      @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  driverId        String                      @map("driver_id") @db.Uuid
  status          DriverBackgroundCheckStatus
  provider        String                      @db.VarChar(50)
  externalCheckId String?                     @map("external_check_id") @db.VarChar(200)
