// Schéma complet — Étape 2 (docs/database-design.md v2 étendu selon le plan
// approuvé /Users/wihem/.claude/plans/keen-munching-ocean.md).
//
// Contraintes non exprimables dans Prisma Schema Language, ajoutées
// manuellement dans la migration SQL (déjà appliquées en base) :
//   - CHECK constraints (montants, dates cohérentes, note 1-5...).
//   - Index uniques PARTIELS sur users.email (WHERE deleted_at IS NULL)
//     et trip_invitations (WHERE status = 'pending').
// Restent volontairement en UNIQUE plein (identité stable, décision
// produit validée — pas une limitation technique) : establishments
// (providerId, externalRef), drivers.userId, bookings (provider,
// providerReference), reviews.bookingId.

datasource db {
  provider          = "postgresql"
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// =============================================================================
// PLATEFORME (module Admin, + Currency utilisé partout)
// =============================================================================

model Currency {
  code          String @id @db.Char(3)
  symbol        String @db.VarChar(5)
  decimalPlaces Int    @default(2) @map("decimal_places") @db.SmallInt

  trips              Trip[]
  bookings           Booking[]
  expenses           Expense[]
  settlements        Settlement[]
  tripBalances       TripBalance[]
  payments           Payment[]
  refunds            Refund[]
  commissionEntries  CommissionEntry[]
  payouts            Payout[]
  invoices           Invoice[]
  walletBalances     WalletBalance[]
  walletTransactions WalletTransaction[]

  @@map("currencies")
}

model File {
  id         String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  ownerType  String    @map("owner_type") @db.VarChar(30)
  ownerId    String    @map("owner_id") @db.Uuid
  uploaderId String    @map("uploader_id") @db.Uuid
  storageKey String    @unique @map("storage_key")
  mimeType   String    @map("mime_type") @db.VarChar(100)
  sizeBytes  BigInt    @map("size_bytes")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz

  uploader User @relation(fields: [uploaderId], references: [id], onDelete: Restrict)

  userAvatarOf     User[]           @relation("UserAvatar")
  tripCoverOf      Trip[]           @relation("TripCover")
  expenseReceiptOf Expense[]        @relation("ExpenseReceipt")
  travelDocumentOf TravelDocument[] @relation("TravelDocumentFile")
  invoicePdfOf     Invoice[]        @relation("InvoicePdf")

  @@index([ownerType, ownerId])
  @@map("files")
}

model AuditLog {
  id         String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.Uuid
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model IdempotencyKey {
  id               String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key              String   @unique @db.VarChar(200)
  responseSnapshot Json?    @map("response_snapshot")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("idempotency_keys")
}

model FeatureFlag {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key               String   @unique @db.VarChar(100)
  description       String?
  enabled           Boolean  @default(false)
  rolloutPercentage Int      @default(0) @map("rollout_percentage") @db.SmallInt
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@map("feature_flags")
}

/// Idempotence des webhooks fournisseurs (contrainte n°10), distincte de
/// IdempotencyKey (réservée aux endpoints API arbitraires).
model WebhookEvent {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  provider        String    @db.VarChar(50)
  eventType       String    @map("event_type") @db.VarChar(100)
  externalEventId String    @map("external_event_id") @db.VarChar(200)
  payload         Json
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz
  processedAt     DateTime? @map("processed_at") @db.Timestamptz
  processingError String?   @map("processing_error")

  @@unique([provider, externalEventId])
  @@index([provider, receivedAt])
  @@map("webhook_events")
}

// =============================================================================
// IDENTITÉ & PROFILS (module Users / Auth)
// =============================================================================

model User {
  id              String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  email           String    @unique @db.Citext
  passwordHash    String    @map("password_hash")
  firstName       String    @map("first_name") @db.VarChar(100)
  lastName        String    @map("last_name") @db.VarChar(100)
  avatarFileId    String?   @map("avatar_file_id") @db.Uuid
  phone           String?   @db.VarChar(30)
  locale          String    @default("fr-FR") @db.VarChar(10)
  timezone        String    @default("Europe/Paris") @db.VarChar(50)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz

  avatarFile File? @relation("UserAvatar", fields: [avatarFileId], references: [id])

  authIdentities          AuthIdentity[]
  refreshTokens           RefreshToken[]
  userRoles               UserRole[]
  travelDocuments         TravelDocument[]
  emergencyContacts       EmergencyContact[]
  uploadedFiles           File[]
  auditLogs               AuditLog[]
  createdTravelGroups     TravelGroup[]
  travelGroupMembers      TravelGroupMember[]
  createdTrips            Trip[]                   @relation("TripCreatedBy")
  tripMemberships         TripMember[]             @relation("TripMemberUser")
  invitedTripMembers      TripMember[]             @relation("TripMemberInvitedBy")
  sentTripInvitations     TripInvitation[]
  availabilities          Availability[]
  createdCalendarEvents   CalendarEvent[]
  personalCalendarEvents  PersonalCalendarEvent[]
  driverProfile           Driver?
  bookedBookings          Booking[]
  sentMessages            Message[]
  messageReads            MessageRead[]
  notifications           Notification[]
  notificationPreferences NotificationPreference[]
  favorites               Favorite[]
  reviews                 Review[]
  wallet                  Wallet?

  @@map("users")
}

/// Prépare le login social (Google, Apple) sans le développer au MVP.
model AuthIdentity {
  id             String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(30)
  providerUserId String   @map("provider_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@map("auth_identities")
}

model RefreshToken {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

/// Rôles globaux de plateforme (admin, support) — distincts des rôles au
/// sein d'un voyage (trip_members.role).
model Role {
  id   String @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name String @unique @db.VarChar(50)

  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

/// Permissions fines, seedées par le code — jamais gérées par une UI
/// dynamique (YAGNI).
model Permission {
  id          String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  key         String  @unique @db.VarChar(150)
  description String?

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

enum TravelDocumentType {
  Passport      @map("passport")
  NationalId    @map("national_id")
  Visa          @map("visa")
  DriverLicense @map("driver_license")
}

/// Passeport/CNI/visa/permis d'un utilisateur. Le numéro complet n'est
/// jamais stocké en clair — seul un identifiant masqué est indexable.
model TravelDocument {
  id                   String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId               String             @map("user_id") @db.Uuid
  type                 TravelDocumentType
  issuingCountry       String             @map("issuing_country") @db.Char(2)
  documentNumberMasked String?            @map("document_number_masked") @db.VarChar(20)
  expiryDate           DateTime           @map("expiry_date") @db.Date
  fileId               String             @map("file_id") @db.Uuid
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?          @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  file File @relation("TravelDocumentFile", fields: [fileId], references: [id])

  @@map("travel_documents")
}

model EmergencyContact {
  id           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(200)
  relationship String    @db.VarChar(50)
  phone        String    @db.VarChar(30)
  email        String?   @db.VarChar(255)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("emergency_contacts")
}

// =============================================================================
// VOYAGES & COLLABORATION (module Trips)
// =============================================================================

enum TravelGroupMemberRole {
  Admin  @map("admin")
  Member @map("member")
}

/// Cercle d'amis persistant, réutilisable sur plusieurs voyages — distinct
/// de TripMember qui reste "qui est confirmé sur CE voyage".
model TravelGroup {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name      String    @db.VarChar(200)
  createdBy String    @map("created_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz

  creator User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  members TravelGroupMember[]
  trips   Trip[]

  @@map("travel_groups")
}

model TravelGroupMember {
  id            String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  travelGroupId String                @map("travel_group_id") @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  role          TravelGroupMemberRole @default(Member)
  joinedAt      DateTime              @default(now()) @map("joined_at") @db.Timestamptz

  travelGroup TravelGroup @relation(fields: [travelGroupId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([travelGroupId, userId])
  @@map("travel_group_members")
}

enum TripStatus {
  Planning  @map("planning")
  Confirmed @map("confirmed")
  Completed @map("completed")
  Archived  @map("archived")
}

model Trip {
  id               String     @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  name             String     @db.VarChar(200)
  description      String?
  coverImageFileId String?    @map("cover_image_file_id") @db.Uuid
  destination      String?    @db.VarChar(200)
  startDate        DateTime?  @map("start_date") @db.Date
  endDate          DateTime?  @map("end_date") @db.Date
  baseCurrency     String     @map("base_currency") @db.Char(3)
  status           TripStatus @default(Planning)
  travelGroupId    String?    @map("travel_group_id") @db.Uuid
  createdBy        String     @map("created_by") @db.Uuid
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt        DateTime?  @map("deleted_at") @db.Timestamptz

  coverImageFile  File?        @relation("TripCover", fields: [coverImageFileId], references: [id])
  baseCurrencyRef Currency     @relation(fields: [baseCurrency], references: [code], onDelete: Restrict)
  travelGroup     TravelGroup? @relation(fields: [travelGroupId], references: [id], onDelete: SetNull)
  creator         User         @relation("TripCreatedBy", fields: [createdBy], references: [id], onDelete: Restrict)

  members        TripMember[]
  invitations    TripInvitation[]
  availabilities Availability[]
  calendarEvents CalendarEvent[]
  bookings       Booking[]
  expenses       Expense[]
  settlements    Settlement[]
  tripBalances   TripBalance[]
  conversation   Conversation?

  @@index([createdBy])
  @@index([status])
  @@map("trips")
}

enum TripMemberRole {
  Owner  @map("owner")
  Editor @map("editor")
  Member @map("member")
}

enum TripMemberStatus {
  Invited  @map("invited")
  Accepted @map("accepted")
  Declined @map("declined")
  Removed  @map("removed")
}

model TripMember {
  id        String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId    String           @map("trip_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  role      TripMemberRole   @default(Member)
  status    TripMemberStatus @default(Invited)
  invitedBy String?          @map("invited_by") @db.Uuid
  joinedAt  DateTime?        @map("joined_at") @db.Timestamptz
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  trip    Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user    User  @relation("TripMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  inviter User? @relation("TripMemberInvitedBy", fields: [invitedBy], references: [id], onDelete: SetNull)

  flightPassengers FlightPassenger[]
  expensesPaid     Expense[]
  expenseShares    ExpenseShare[]
  settlementsFrom  Settlement[]      @relation("SettlementFrom")
  settlementsTo    Settlement[]      @relation("SettlementTo")
  tripBalances     TripBalance[]
  paymentsMade     Payment[]

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

/// Invitations par email vers des personnes pas encore inscrites. `status`
/// reste varchar (non converti en enum, cf. plan §3).
model TripInvitation {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  email     String   @db.Citext
  token     String   @unique @db.VarChar(64)
  invitedBy String   @map("invited_by") @db.Uuid
  status    String   @default("pending") @db.VarChar(20)
  expiresAt DateTime @map("expires_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  trip    Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  inviter User @relation(fields: [invitedBy], references: [id], onDelete: Cascade)

  @@unique([tripId, email])
  @@map("trip_invitations")
}

enum AvailabilityStatus {
  Available   @map("available")
  Unavailable @map("unavailable")
  Maybe       @map("maybe")
}

model Availability {
  id        String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId    String             @map("trip_id") @db.Uuid
  userId    String             @map("user_id") @db.Uuid
  date      DateTime           @db.Date
  status    AvailabilityStatus
  createdAt DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([tripId, userId, date])
  @@index([tripId, date])
  @@map("availabilities")
}

/// Événements du voyage — collaboratif, visible par tous les membres.
model CalendarEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId      String    @map("trip_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  startAt     DateTime  @map("start_at") @db.Timestamptz
  endAt       DateTime? @map("end_at") @db.Timestamptz
  location    String?   @db.VarChar(200)
  createdBy   String?   @map("created_by") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  trip    Trip  @relation(fields: [tripId], references: [id], onDelete: Cascade)
  creator User? @relation(fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([tripId, startAt])
  @@map("calendar_events")
}

/// Calendrier PERSONNEL — table distincte de CalendarEvent pour que la
/// frontière de confidentialité soit structurelle (§10.3 du plan).
model PersonalCalendarEvent {
  id          String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String    @db.VarChar(200)
  description String?
  startAt     DateTime  @map("start_at") @db.Timestamptz
  endAt       DateTime? @map("end_at") @db.Timestamptz
  location    String?   @db.VarChar(200)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startAt])
  @@map("personal_calendar_events")
}

// =============================================================================
// PRESTATAIRES & ÉTABLISSEMENTS (module Providers) — marketplace partiel
// =============================================================================

enum ProviderType {
  Aggregator    @map("aggregator")
  DirectPartner @map("direct_partner")
}

enum ProviderOnboardingStatus {
  Pending   @map("pending")
  Verified  @map("verified")
  Active    @map("active")
  Suspended @map("suspended")
}

model Provider {
  id                    String                   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  type                  ProviderType
  businessName          String                   @map("business_name") @db.VarChar(200)
  legalName             String?                  @map("legal_name") @db.VarChar(200)
  taxId                 String?                  @map("tax_id") @db.VarChar(50)
  contactEmail          String?                  @map("contact_email") @db.VarChar(255)
  contactPhone          String?                  @map("contact_phone") @db.VarChar(30)
  commissionRateDefault Decimal                  @default(0) @map("commission_rate_default") @db.Decimal(5, 4)
  onboardingStatus      ProviderOnboardingStatus @default(Pending) @map("onboarding_status")
  verifiedAt            DateTime?                @map("verified_at") @db.Timestamptz
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt             DateTime?                @map("deleted_at") @db.Timestamptz

  establishments Establishment[]
  drivers        Driver[]
  payoutAccounts ProviderPayoutAccount[]

  @@map("providers")
}

enum EstablishmentType {
  Hotel           @map("hotel")
  Restaurant      @map("restaurant")
  ActivityVenue   @map("activity_venue")
  CarRentalBranch @map("car_rental_branch")
  EventVenue      @map("event_venue")
}

enum EstablishmentStatus {
  Active    @map("active")
  Inactive  @map("inactive")
  Suspended @map("suspended")
}

/// Instance physique (hôtel, restaurant, agence de location, salle
/// d'activité/événement). `UNIQUE(providerId, externalRef)` profite
/// nativement de la sémantique NULL de PostgreSQL (deux NULL ne sont jamais
/// égaux) — aucune clause WHERE partielle nécessaire pour ce cas précis.
model Establishment {
  id                     String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  providerId             String              @map("provider_id") @db.Uuid
  type                   EstablishmentType
  name                   String              @db.VarChar(200)
  addressLine1           String?             @map("address_line1") @db.VarChar(255)
  city                   String?             @db.VarChar(120)
  countryCode            String?             @map("country_code") @db.Char(2)
  latitude               Decimal?            @db.Decimal(9, 6)
  longitude              Decimal?            @db.Decimal(9, 6)
  externalRef            String?             @map("external_ref") @db.VarChar(200)
  commissionRateOverride Decimal?            @map("commission_rate_override") @db.Decimal(5, 4)
  status                 EstablishmentStatus @default(Active)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt              DateTime?           @map("deleted_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)

  carRentalBookings  CarRentalBooking[]
  activityBookings   ActivityBooking[]
  restaurantBookings RestaurantBooking[]
  deliveryOrders     DeliveryOrder[]
  eventBookingsVenue EventBooking[]

  @@unique([providerId, externalRef])
  @@index([type, city])
  @@map("establishments")
}

enum DriverStatus {
  PendingVerification @map("pending_verification")
  Active              @map("active")
  Suspended           @map("suspended")
  Deactivated         @map("deactivated")
}

/// Chauffeur/livreur recruté par la plateforme. `userId` unique — un
/// chauffeur est aussi un utilisateur, pas de duplication d'identité.
model Driver {
  id         String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  providerId String       @map("provider_id") @db.Uuid
  userId     String       @unique @map("user_id") @db.Uuid
  status     DriverStatus @default(PendingVerification)
  createdAt  DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?    @map("deleted_at") @db.Timestamptz

  provider Provider @relation(fields: [providerId], references: [id], onDelete: Restrict)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  vehicles         Vehicle[]
  backgroundChecks DriverBackgroundCheck[]
  payoutAccounts   DriverPayoutAccount[]
  rideBookings     RideBooking[]
  deliveryOrders   DeliveryOrder[]

  @@map("drivers")
}

enum VehicleType {
  Sedan   @map("sedan")
  Van     @map("van")
  Scooter @map("scooter")
  Bike    @map("bike")
}

enum VehicleStatus {
  Active   @map("active")
  Inactive @map("inactive")
}

/// Véhicule d'un chauffeur (VTC/livraison) — ne couvre pas les flottes de
/// location (car_rental_bookings reste dénormalisé, cf. plan §8).
model Vehicle {
