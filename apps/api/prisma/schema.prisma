  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@index([driverId, checkedAt(sort: Desc)])
  @@map("driver_background_checks")
}

/// Référence tokenisée vers un compte de reversement (Stripe Connect ou
/// équivalent) — aucune donnée bancaire brute stockée (cf. plan §7).
model ProviderPayoutAccount {
