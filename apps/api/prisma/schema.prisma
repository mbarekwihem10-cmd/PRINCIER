  createdAt                DateTime @default(now()) @map("created_at") @db.Timestamptz

  driver Driver @relation(fields: [driverId], references: [id], onDelete: Cascade)

  @@map("driver_payout_accounts")
}

// =============================================================================
// RÉSERVATIONS MULTI-SERVICES — kernel Bookings + verticaux
// =============================================================================

enum BookingType {
  Flight     @map("flight")
  Stay       @map("stay")
  Ride       @map("ride")
  CarRental  @map("car_rental")
  Activity   @map("activity")
  Restaurant @map("restaurant")
  Delivery   @map("delivery")
  Event      @map("event")
  Esim       @map("esim")
}

enum BookingStatus {
  Pending   @map("pending")
  Confirmed @map("confirmed")
  Cancelled @map("cancelled")
  Failed    @map("failed")
}

/// Header générique partagé par tous les verticaux de réservation. Possédé
/// par le module kernel `Bookings` (cf. plan §10.1) — les modules verticaux
/// n'accèdent jamais directement à ce repository, uniquement via
/// BookingsService. Le header reste strictement limité à ces champs :
/// toute donnée spécifique à un vertical vit dans sa table de détail ou
/// dans raw_provider_payload (risque de dérive documenté en §11 du plan).
model Booking {
  id                String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId            String        @map("trip_id") @db.Uuid
  type              BookingType
  provider          String        @db.VarChar(50)
  providerReference String        @map("provider_reference") @db.VarChar(200)
  status            BookingStatus @default(Pending)
  totalAmount       Decimal       @map("total_amount") @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  bookedBy          String        @map("booked_by") @db.Uuid
  version           Int           @default(0)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt         DateTime?     @map("deleted_at") @db.Timestamptz

  trip        Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)
  booker      User     @relation(fields: [bookedBy], references: [id], onDelete: Restrict)

  flightBooking     FlightBooking?
  stayBooking       StayBooking?
  rideBooking       RideBooking?
  carRentalBooking  CarRentalBooking?
  activityBooking   ActivityBooking?
  restaurantBooking RestaurantBooking?
  deliveryOrder     DeliveryOrder?
  eventBooking      EventBooking?
  esimOrder         EsimOrder?

  payments          Payment[]
  commissionEntries CommissionEntry[]
  reviews           Review[]

  @@unique([provider, providerReference])
  @@index([tripId, type])
  @@map("bookings")
}

model FlightBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  originAirport                String   @map("origin_airport") @db.Char(3)
  destinationAirport           String   @map("destination_airport") @db.Char(3)
  departureAt                  DateTime @map("departure_at") @db.Timestamptz
  arrivalAt                    DateTime @map("arrival_at") @db.Timestamptz
  airline                      String   @db.VarChar(100)
  flightNumber                 String   @map("flight_number") @db.VarChar(10)
  cabinClass                   String   @map("cabin_class") @db.VarChar(20)
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking    Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  passengers FlightPassenger[]

  @@map("flight_bookings")
}

model FlightPassenger {
  id              String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  flightBookingId String   @map("flight_booking_id") @db.Uuid
  tripMemberId    String   @map("trip_member_id") @db.Uuid
  firstName       String   @map("first_name") @db.VarChar(100)
  lastName        String   @map("last_name") @db.VarChar(100)
  seat            String?  @db.VarChar(10)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz

  flightBooking FlightBooking @relation(fields: [flightBookingId], references: [id], onDelete: Cascade)
  tripMember    TripMember    @relation(fields: [tripMemberId], references: [id], onDelete: Cascade)

  @@map("flight_passengers")
}

model StayBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  propertyName                 String   @map("property_name") @db.VarChar(200)
  address                      String?
  checkInDate                  DateTime @map("check_in_date") @db.Date
  checkOutDate                 DateTime @map("check_out_date") @db.Date
  guestsCount                  Int      @map("guests_count") @db.SmallInt
  providerPropertyId           String?  @map("provider_property_id") @db.VarChar(100)
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([checkInDate, checkOutDate])
  @@map("stay_bookings")
}

model RideBooking {
  id                           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String    @unique @map("booking_id") @db.Uuid
  driverId                     String?   @map("driver_id") @db.Uuid
  vehicleId                    String?   @map("vehicle_id") @db.Uuid
  pickupLocation               String    @map("pickup_location") @db.VarChar(255)
  pickupLatitude               Decimal?  @map("pickup_latitude") @db.Decimal(9, 6)
  pickupLongitude              Decimal?  @map("pickup_longitude") @db.Decimal(9, 6)
  dropoffLocation              String    @map("dropoff_location") @db.VarChar(255)
  dropoffLatitude              Decimal?  @map("dropoff_latitude") @db.Decimal(9, 6)
  dropoffLongitude             Decimal?  @map("dropoff_longitude") @db.Decimal(9, 6)
  requestedAt                  DateTime  @map("requested_at") @db.Timestamptz
  pickedUpAt                   DateTime? @map("picked_up_at") @db.Timestamptz
  droppedOffAt                 DateTime? @map("dropped_off_at") @db.Timestamptz
  rawProviderPayload           Json      @map("raw_provider_payload")
  providerPayloadSchemaVersion String    @map("provider_payload_schema_version") @db.VarChar(20)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  driver  Driver?  @relation(fields: [driverId], references: [id], onDelete: SetNull)
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)

  @@map("ride_bookings")
}

model CarRentalBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  establishmentId              String   @map("establishment_id") @db.Uuid
  vehicleCategory              String   @map("vehicle_category") @db.VarChar(100)
  pickupAt                     DateTime @map("pickup_at") @db.Timestamptz
  dropoffAt                    DateTime @map("dropoff_at") @db.Timestamptz
  pickupLocation               String   @map("pickup_location") @db.VarChar(255)
  dropoffLocation              String   @map("dropoff_location") @db.VarChar(255)
  driverAge                    Int?     @map("driver_age") @db.SmallInt
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@map("car_rental_bookings")
}

model ActivityBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  establishmentId              String?  @map("establishment_id") @db.Uuid
  activityName                 String   @map("activity_name") @db.VarChar(200)
  scheduledAt                  DateTime @map("scheduled_at") @db.Timestamptz
  participantsCount            Int      @map("participants_count") @db.SmallInt
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking       Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  establishment Establishment? @relation(fields: [establishmentId], references: [id], onDelete: SetNull)

  @@map("activity_bookings")
}

model RestaurantBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  establishmentId              String   @map("establishment_id") @db.Uuid
  reservationAt                DateTime @map("reservation_at") @db.Timestamptz
  partySize                    Int      @map("party_size") @db.SmallInt
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)

  @@map("restaurant_bookings")
}

model DeliveryOrder {
  id                           String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String    @unique @map("booking_id") @db.Uuid
  establishmentId              String    @map("establishment_id") @db.Uuid
  driverId                     String?   @map("driver_id") @db.Uuid
  deliveryAddress              String    @map("delivery_address") @db.VarChar(255)
  orderedAt                    DateTime  @map("ordered_at") @db.Timestamptz
  deliveredAt                  DateTime? @map("delivered_at") @db.Timestamptz
  rawProviderPayload           Json      @map("raw_provider_payload")
  providerPayloadSchemaVersion String    @map("provider_payload_schema_version") @db.VarChar(20)

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Restrict)
  driver        Driver?       @relation(fields: [driverId], references: [id], onDelete: SetNull)

  @@map("delivery_orders")
}

model EventBooking {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  eventName                    String   @map("event_name") @db.VarChar(200)
  venueEstablishmentId         String?  @map("venue_establishment_id") @db.Uuid
  eventAt                      DateTime @map("event_at") @db.Timestamptz
  ticketCount                  Int      @map("ticket_count") @db.SmallInt
  seatInfo                     Json?    @map("seat_info")
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking            Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  venueEstablishment Establishment? @relation(fields: [venueEstablishmentId], references: [id], onDelete: SetNull)

