}

model EsimOrder {
  id                           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId                    String   @unique @map("booking_id") @db.Uuid
  dataPlanName                 String   @map("data_plan_name") @db.VarChar(200)
  region                       String   @db.VarChar(100)
  activationCode               String?  @map("activation_code")
  validFrom                    DateTime @map("valid_from") @db.Date
  validUntil                   DateTime @map("valid_until") @db.Date
  rawProviderPayload           Json     @map("raw_provider_payload")
  providerPayloadSchemaVersion String   @map("provider_payload_schema_version") @db.VarChar(20)

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@map("esim_orders")
}

// =============================================================================
// DÉPENSES (module Expenses) — inchangé par rapport à docs/database-design.md v2
// =============================================================================

model Expense {
  id                   String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId               String    @map("trip_id") @db.Uuid
  paidBy               String    @map("paid_by") @db.Uuid
  description          String    @db.VarChar(200)
  amount               Decimal   @db.Decimal(12, 2)
  currency             String    @db.Char(3)
  exchangeRateToBase   Decimal   @default(1) @map("exchange_rate_to_base") @db.Decimal(12, 6)
  amountInBaseCurrency Decimal   @map("amount_in_base_currency") @db.Decimal(12, 2)
  category             String    @default("other") @db.VarChar(30)
  expenseDate          DateTime  @map("expense_date") @db.Date
  receiptFileId        String?   @map("receipt_file_id") @db.Uuid
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime? @map("deleted_at") @db.Timestamptz

  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  payer       TripMember @relation(fields: [paidBy], references: [id], onDelete: Restrict)
  currencyRef Currency   @relation(fields: [currency], references: [code], onDelete: Restrict)
  receiptFile File?      @relation("ExpenseReceipt", fields: [receiptFileId], references: [id])

  shares ExpenseShare[]

  @@index([tripId, expenseDate])
  @@map("expenses")
}

model ExpenseShare {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  expenseId    String   @map("expense_id") @db.Uuid
  tripMemberId String   @map("trip_member_id") @db.Uuid
  shareAmount  Decimal  @map("share_amount") @db.Decimal(12, 2)
  isSettled    Boolean  @default(false) @map("is_settled")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  expense    Expense    @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tripMember TripMember @relation(fields: [tripMemberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, tripMemberId])
  @@index([tripMemberId, isSettled])
  @@map("expense_shares")
}

model Settlement {
  id           String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId       String   @map("trip_id") @db.Uuid
  fromMemberId String   @map("from_member_id") @db.Uuid
  toMemberId   String   @map("to_member_id") @db.Uuid
  amount       Decimal  @db.Decimal(12, 2)
  currency     String   @db.Char(3)
  settledAt    DateTime @map("settled_at") @db.Timestamptz
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromMember  TripMember @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember    TripMember @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Restrict)
  currencyRef Currency   @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@map("settlements")
}

/// Projection dérivée, jamais source de vérité — expense_shares reste
/// l'unique source de vérité (garde-fou : job de réconciliation).
model TripBalance {
  id            String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId        String   @map("trip_id") @db.Uuid
  tripMemberId  String   @map("trip_member_id") @db.Uuid
  balanceAmount Decimal  @default(0) @map("balance_amount") @db.Decimal(12, 2)
  currency      String   @db.Char(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  trip        Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)
  tripMember  TripMember @relation(fields: [tripMemberId], references: [id], onDelete: Cascade)
  currencyRef Currency   @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([tripId, tripMemberId])
  @@map("trip_balances")
}

// =============================================================================
// PAIEMENTS & FINANCE (modules Payments et Wallet)
// =============================================================================

enum PaymentMethod {
  Card   @map("card")
  Wallet @map("wallet")
  Mixed  @map("mixed")
}

enum PaymentStatus {
  Pending           @map("pending")
  Authorized        @map("authorized")
  Captured          @map("captured")
  Failed            @map("failed")
  Refunded          @map("refunded")
  PartiallyRefunded @map("partially_refunded")
}

/// Financièrement immuable : aucune colonne deleted_at, un paiement ne se
/// supprime jamais (cf. plan §6/§7).
model Payment {
  id                 String        @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId          String        @map("booking_id") @db.Uuid
  payerId            String        @map("payer_id") @db.Uuid
  method             PaymentMethod
  amount             Decimal       @db.Decimal(12, 2)
  currency           String        @db.Char(3)
  status             PaymentStatus @default(Pending)
  provider           String        @db.VarChar(50)
  providerReference  String?       @map("provider_reference") @db.VarChar(200)
  idempotencyKey     String        @unique @map("idempotency_key") @db.VarChar(200)
  rawProviderPayload Json?         @map("raw_provider_payload")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  booking     Booking    @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payer       TripMember @relation(fields: [payerId], references: [id], onDelete: Restrict)
  currencyRef Currency   @relation(fields: [currency], references: [code], onDelete: Restrict)

  refunds           Refund[]
  commissionEntries CommissionEntry[]

  @@index([payerId, createdAt])
  @@index([bookingId])
  @@map("payments")
}

enum RefundStatus {
  Pending   @map("pending")
  Processed @map("processed")
  Failed    @map("failed")
}

model Refund {
  id                String       @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  paymentId         String       @map("payment_id") @db.Uuid
  amount            Decimal      @db.Decimal(12, 2)
  currency          String       @db.Char(3)
  reason            String?      @db.VarChar(255)
  status            RefundStatus @default(Pending)
  providerReference String?      @map("provider_reference") @db.VarChar(200)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  processedAt       DateTime?    @map("processed_at") @db.Timestamptz

  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@map("refunds")
}

enum CommissionRecipientType {
  Platform @map("platform")
  Provider @map("provider")
  Driver   @map("driver")
}

/// rateApplied est figé au moment du calcul, jamais recalculé
/// rétroactivement (même principe que expense_shares.share_amount).
model CommissionEntry {
  id            String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  bookingId     String                  @map("booking_id") @db.Uuid
  paymentId     String                  @map("payment_id") @db.Uuid
  recipientType CommissionRecipientType @map("recipient_type")
  recipientId   String?                 @map("recipient_id") @db.Uuid
  rateApplied   Decimal                 @map("rate_applied") @db.Decimal(5, 4)
  amount        Decimal                 @db.Decimal(12, 2)
  currency      String                  @db.Char(3)
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz

  booking     Booking  @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  payment     Payment  @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  payoutLineItems PayoutLineItem[]

  @@map("commission_entries")
}

enum PayoutRecipientType {
  Provider @map("provider")
  Driver   @map("driver")
}

enum PayoutStatus {
  Pending    @map("pending")
  Processing @map("processing")
  Paid       @map("paid")
  Failed     @map("failed")
}

model Payout {
  id                     String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  recipientType          PayoutRecipientType @map("recipient_type")
  recipientId            String              @map("recipient_id") @db.Uuid
  periodStart            DateTime            @map("period_start") @db.Date
  periodEnd              DateTime            @map("period_end") @db.Date
  amount                 Decimal             @db.Decimal(12, 2)
  currency               String              @db.Char(3)
  status                 PayoutStatus        @default(Pending)
  payoutAccountReference String              @map("payout_account_reference") @db.VarChar(200)
  externalPayoutId       String?             @map("external_payout_id") @db.VarChar(200)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt              DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  paidAt                 DateTime?           @map("paid_at") @db.Timestamptz

  currencyRef Currency         @relation(fields: [currency], references: [code], onDelete: Restrict)
  lineItems   PayoutLineItem[]

  @@map("payouts")
}

/// UNIQUE(payoutId, commissionEntryId) empêche de compter deux fois la
/// même commission dans deux reversements différents.
model PayoutLineItem {
  id                String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  payoutId          String   @map("payout_id") @db.Uuid
  commissionEntryId String   @map("commission_entry_id") @db.Uuid
  amount            Decimal  @db.Decimal(12, 2)
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz

  payout          Payout          @relation(fields: [payoutId], references: [id], onDelete: Cascade)
  commissionEntry CommissionEntry @relation(fields: [commissionEntryId], references: [id], onDelete: Restrict)

  @@unique([payoutId, commissionEntryId])
  @@map("payout_line_items")
}

enum InvoiceIssuedToType {
  User     @map("user")
  Provider @map("provider")
}

enum InvoiceStatus {
  Draft  @map("draft")
  Issued @map("issued")
  Paid   @map("paid")
  Void   @map("void")
}

/// Annulation = passage à Void, jamais de suppression (pratique comptable
/// standard). Aucun moteur de TVA/fiscalité multi-juridiction (hors périmètre).
model Invoice {
  id           String              @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  issuedToType InvoiceIssuedToType @map("issued_to_type")
  issuedToId   String              @map("issued_to_id") @db.Uuid
  status       InvoiceStatus       @default(Draft)
  currency     String              @db.Char(3)
  totalAmount  Decimal             @map("total_amount") @db.Decimal(12, 2)
  issuedAt     DateTime?           @map("issued_at") @db.Timestamptz
  dueAt        DateTime?           @map("due_at") @db.Timestamptz
  pdfFileId    String?             @map("pdf_file_id") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)
  pdfFile     File?    @relation("InvoicePdf", fields: [pdfFileId], references: [id])

  lineItems InvoiceLineItem[]

  @@map("invoices")
}

enum InvoiceReferenceType {
  Payment         @map("payment")
  CommissionEntry @map("commission_entry")
  Expense         @map("expense")
}

model InvoiceLineItem {
  id            String                @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  invoiceId     String                @map("invoice_id") @db.Uuid
  description   String                @db.VarChar(255)
  amount        Decimal               @db.Decimal(12, 2)
  referenceType InvoiceReferenceType? @map("reference_type")
  referenceId   String?               @map("reference_id") @db.Uuid
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_line_items")
}

/// Un portefeuille par utilisateur. `userId` en RESTRICT (et non CASCADE) :
/// la suppression physique d'un utilisateur ne doit jamais entraîner la
/// suppression en cascade de son wallet ni de son historique de
/// transactions (WalletTransaction est un grand livre immuable, même
/// traitement que AuditLog.actorId). La suppression de compte passe par un
/// processus applicatif qui règle/transfère le solde au préalable, jamais
/// un DELETE brut cascadé (même principe que trips.createdBy).
model Wallet {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  balances     WalletBalance[]
  transactions WalletTransaction[]

  @@map("wallets")
}

/// Projection dérivée par devise — jamais source de vérité (même
/// garde-fou que TripBalance). Cloisonné par devise, aucune conversion en
/// V1 (cf. plan §13 pour l'extensibilité future sans refonte).
model WalletBalance {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  walletId  String   @map("wallet_id") @db.Uuid
  currency  String   @db.Char(3)
  balance   Decimal  @default(0) @db.Decimal(12, 2)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Cascade)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@unique([walletId, currency])
  @@map("wallet_balances")
}

enum WalletTransactionType {
  Credit @map("credit")
  Debit  @map("debit")
}

enum WalletTransactionReason {
  TopUp          @map("top_up")
  Payment        @map("payment")
  Refund         @map("refund")
  PayoutReceived @map("payout_received")
  Adjustment     @map("adjustment")
}

enum WalletReferenceType {
  Payment @map("payment")
  Refund  @map("refund")
  Payout  @map("payout")
}

/// Grand livre immuable — aucune colonne updatedAt/deletedAt (même
/// traitement que AuditLog). `walletId` en RESTRICT (et non CASCADE) : un
/// wallet possédant des transactions ne peut jamais être supprimé
/// physiquement, même directement en base — il doit être clôturé ou
/// désactivé (via un futur statut applicatif), jamais effacé. Ceci protège
/// le grand livre d'une suppression accidentelle du wallet parent, en plus
/// de la protection déjà apportée par Wallet.userId en RESTRICT.
model WalletTransaction {
  id            String                  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  walletId      String                  @map("wallet_id") @db.Uuid
  type          WalletTransactionType
  amount        Decimal                 @db.Decimal(12, 2)
  currency      String                  @db.Char(3)
  reason        WalletTransactionReason
  referenceType WalletReferenceType?    @map("reference_type")
  referenceId   String?                 @map("reference_id") @db.Uuid
  createdAt     DateTime                @default(now()) @map("created_at") @db.Timestamptz

  wallet      Wallet   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  currencyRef Currency @relation(fields: [currency], references: [code], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

// =============================================================================
// MESSAGERIE (module Messaging) — inchangé
// =============================================================================

model Conversation {
  id        String   @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  tripId    String   @unique @map("trip_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  messages Message[]

  @@map("conversations")
}

/// message_type reste varchar (déjà varchar en v2, inchangé, cf. plan §3).
model Message {
  id             String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  conversationId String    @map("conversation_id") @db.Uuid
  senderId       String?   @map("sender_id") @db.Uuid
  content        String
  messageType    String    @default("text") @map("message_type") @db.VarChar(20)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz

  conversation Conversation  @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User?         @relation(fields: [senderId], references: [id], onDelete: SetNull)
  reads        MessageRead[]

  @@index([conversationId, createdAt])
  @@map("messages")
}

model MessageRead {
  messageId String   @map("message_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  readAt    DateTime @default(now()) @map("read_at") @db.Timestamptz

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@map("message_reads")
}

// =============================================================================
// NOTIFICATIONS — inchangé
// =============================================================================

/// type reste varchar (déjà varchar en v2, inchangé, cf. plan §3).
model Notification {
  id        String    @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      String    @db.VarChar(50)
  payload   Json
  readAt    DateTime? @map("read_at") @db.Timestamptz
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  id               String  @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId           String  @map("user_id") @db.Uuid
  notificationType String  @map("notification_type") @db.VarChar(50)
  channel          String  @db.VarChar(20)
  enabled          Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, notificationType, channel])
  @@map("notification_preferences")
}

// =============================================================================
// ENGAGEMENT (module Engagement, nouveau) — favoris et avis
// =============================================================================

/// Déviation par rapport au plan initial (voir rapport de fin d'étape) :
/// "activity"/"restaurant" ont été retirés de FavoriteTargetType car ils ne
/// sont pas des tables distinctes — ce sont des Establishment.type. Un
/// discriminant Establishment|Driver suffit ; le sous-type reste
/// disponible via establishments.type.
enum FavoriteTargetType {
  Establishment @map("establishment")
  Driver        @map("driver")
}

model Favorite {
  id         String             @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  targetType FavoriteTargetType @map("target_type")
  targetId   String             @map("target_id") @db.Uuid
  createdAt  DateTime           @default(now()) @map("created_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, targetType, targetId])
  @@index([userId])
  @@map("favorites")
}

/// Même déviation que FavoriteTargetType (cf. commentaire ci-dessus).
enum ReviewTargetType {
  Establishment @map("establishment")
  Driver        @map("driver")
}

/// Pattern "achat vérifié" — bookingId NOT NULL empêche les faux avis.
/// UNIQUE(bookingId) : un avis par réservation, pas par cible (un même
/// utilisateur peut légitimement re-séjourner et re-noter).
model Review {
  id         String           @id @default(dbgenerated("uuid_generate_v7()")) @db.Uuid
  userId     String?          @map("user_id") @db.Uuid
  bookingId  String           @unique @map("booking_id") @db.Uuid
  targetType ReviewTargetType @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  rating     Int              @db.SmallInt
  comment    String?
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime?        @map("deleted_at") @db.Timestamptz

  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)

  @@index([targetType, targetId])
  @@map("reviews")
}
