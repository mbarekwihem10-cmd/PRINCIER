# Gabarit pour apps/api/.env.test (non commité, ignoré par .gitignore).
# Copier ce fichier vers .env.test puis l'ajuster si besoin.
#
# DATABASE_URL doit obligatoirement cibler une base dont le nom se termine
# par "_test", sur un hôte strictement local (localhost / 127.0.0.1 / ::1).
# apps/api/test/e2e-safety/assert-safe-e2e-database.ts refuse fail-fast
# toute autre configuration avant même d'ouvrir une connexion.
#
# SHADOW_DATABASE_URL est volontairement absent : `prisma migrate deploy`
# (seule commande Prisma utilisée par le flux E2E) ne l'utilise pas — c'est
# une spécificité de `prisma migrate dev`, non appelé ici.
NODE_ENV=test
DATABASE_URL=postgresql://tripplanner:tripplanner@localhost:5432/tripplanner_test
JWT_ACCESS_SECRET=test-only-not-a-real-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=test-only-not-a-real-secret
JWT_REFRESH_TTL=30d
REDIS_URL=redis://localhost:6379
LOG_LEVEL=silent
PORT=3001
